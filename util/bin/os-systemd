#!/usr/bin/env bash

# Operating System Information command
# ====================================
#
# Prints information about the operating system via Systemd's `hostnamectl`
# program.
#
# Tim Friske <me@tifr.de>
#
# Deps:: bash, env, hostnamectl

# Ensure fail-fast script execution.
shopt -s inherit_errexit
shopt -so nounset pipefail errtrace errexit

hostnamectl status
