#!/usr/bin/env bash

# Mirror command
# ==============
# Tim Friske <me@tifr.de>
#
# The verb `mirror` should be more memorable than the alternative of having to
# type `rsync` together with all these options.
#
# Deps:: bash, env, rsync

# Ensure fail-fast script execution.
shopt -s inherit_errexit
shopt -so nounset pipefail errtrace errexit

read -r -a rsync_x_options <<< "${RSYNC_X_OPTIONS:-}"
rsync "${rsync_x_options[@]}" --archive --hard-links --acls --xattrs --delete "${@}"
