#!/usr/bin/env bash

# Argo Rl command
# ===============
# Tim Friske <me@tifr.de>
#
# Retries the given Argo workflow and follows (tails) its logs.
#
# Deps:: argo, bash, env

# Ensure fail-fast script execution.
shopt -s inherit_errexit
shopt -so nounset pipefail errtrace errexit

argo retry --log "${@}"
