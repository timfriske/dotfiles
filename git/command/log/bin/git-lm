#!/usr/bin/env bash

# Git Log command
# ===============
# Tim Friske <me@tifr.de>
#
# Logs commits of main branch (first parent), not those of side branches.
#
# Deps:: bash, env, git-log

# Ensure fail-fast script execution.
shopt -s inherit_errexit
shopt -so nounset pipefail errtrace errexit

function main {
  local commit="${1:-HEAD}" args=("${@:2}")
  (cd "${GIT_PREFIX:-.}" && git log --first-parent --oneline --decorate=auto "${commit}" -- "${args:-.}")
}

main "${@}"
