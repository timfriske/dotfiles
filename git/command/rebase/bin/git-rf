#!/usr/bin/env bash

# Git Rebase command
# ==================
# Tim Friske <me@tifr.de>
#
# Deps:: bash, env, git-rebase

# Ensure fail-fast script execution.
shopt -s inherit_errexit
shopt -so nounset pipefail errtrace errexit

git rebase --force-rebase ${GIT_X_SIGNOFF:+"${GIT_X_SIGNOFF}"} "${@:-HEAD~}"
