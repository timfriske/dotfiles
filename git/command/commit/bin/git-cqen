#!/usr/bin/env bash

# Git Commit command
# ==================
# Tim Friske <me@tifr.de>
#
# Deps:: bash, env, git-commit

# Ensure fail-fast script execution.
shopt -s inherit_errexit
shopt -so nounset pipefail errtrace errexit

function main {
  local commit="${1:-HEAD~1}"
  local of_commit="${2:-${commit}}"
  local args=("${@:3}")
  git commit --squash="${commit}" --no-edit --reuse-message="${of_commit}" ${GIT_X_SIGNOFF:+"${GIT_X_SIGNOFF}"} --reset-author "${args[@]}"
}

main "${@}"
