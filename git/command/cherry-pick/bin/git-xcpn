#!/usr/bin/env bash

# Git Cherry-pick command
# =======================
# Tim Friske <me@tifr.de>
#
# Deps:: bash, env, git-cherry-pick

# Ensure fail-fast script execution.
shopt -s inherit_errexit
shopt -so nounset pipefail errtrace errexit

git cherry-pick --no-commit ${GIT_X_SIGNOFF:+"${GIT_X_SIGNOFF}"} "${@}"
